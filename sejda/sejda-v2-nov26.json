{
  "config_version": 2,
  "app": {
    "min_version_code": 200,
    "latest_version_code": 200,
    "play_store_url": "https://play.google.com/store/apps/details?id=com.sejda.pdf.tools.editorpdf",
    "update_message": {
      "en": "A new version is available.",
      "fr": "Une nouvelle version est disponible.",
      "ar": "يتوفر إصدار جديد من التطبيق."
    },
    "force_update_message": {
      "en": "Please update the app to keep using it.",
      "fr": "Veuillez mettre à jour l'application pour continuer.",
      "ar": "يرجى تحديث التطبيق لمواصلة استخدامه."
    },
    "kill_switch": false,
    "kill_message": {
      "en": "The app is under maintenance. Please try again later.",
      "fr": "L'application est en maintenance. Réessayez plus tard.",
      "ar": "التطبيق قيد الصيانة. يرجى المحاولة لاحقاً."
    }
  },
  "notifications": {
    "enabled": true,
    "min_interval_days": 3,
    "quiet_start": 21,
    "quiet_end": 9,
    "tips_enabled": true,
    "new_pdf_enabled": true
  },
  "default_app": {
    "enabled": true,
    "min_sessions": 2,
    "repeat_days": 7,
    "max_times": 3
  },
  "ads": {
    "enabled": true,
    "formats": {
      "banner": {
        "enabled": true,
        "order": ["max", "admob", "own"],
        "timeout_ms": 6000,
        "refresh_s": 60
      },
      "native": {
        "enabled": true,
        "order": ["max", "admob", "own"],
        "timeout_ms": 6000,
        "native_ad_index": 3,
        "native_ad_interval": 8
      },
      "interstitial": {
        "enabled": true,
        "order": ["max", "admob"],
        "timeout_ms": 5000,
        "min_interval_s": 90
      },
      "app_open": {
        "enabled": true,
        "order": ["admob", "max"],
        "timeout_ms": 4000,
        "min_interval_s": 300
      },
      "rewarded": {
        "enabled": true,
        "order": ["max", "admob"],
        "timeout_ms": 8000
      }
    },
    "max_units": {
      "banner": "",
      "native": "",
      "interstitial": "",
      "app_open": "",
      "rewarded": ""
    },
    "admob_units": {
      "banner": "",
      "native": "",
      "interstitial": "",
      "app_open": "",
      "rewarded": ""
    },
    "own_ads": []
  }
}
